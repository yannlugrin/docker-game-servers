{
  "autoMemoryEnabled": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Bash(just)",
      "Bash(just check)",
      "Bash(just check all)",
      "Bash(just check changed)",
      "Bash(just test)",
      "Bash(just verify)",
      "Bash(just setup)",
      "Bash(just --list*)",
      "Bash(just --summary*)",
      "Bash(just --version)",
      "Bash(python3 -m unittest*)",
      "Bash(.venv/bin/pre-commit run*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git blame*)",
