      "Bash(git cat-file*)",
      "Bash(git for-each-ref*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -v*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git worktree list*)",
      "Bash(git stash list*)",
      "Bash(git tag)",
      "Bash(git tag -l*)",
      "Bash(git tag --list*)",

      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit --message *)",
      "Bash(git tag -a *)",
      "Bash(git tag --annotate *)",

      "Bash(docker build *)",
      "Bash(docker buildx build *)",
      "Bash(docker run *)",
      "Bash(docker create *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker kill *)",
      "Bash(docker exec *)",
      "Bash(docker cp *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker port *)",
      "Bash(docker top *)",
      "Bash(docker stats*)",
      "Bash(docker diff *)",
      "Bash(docker version*)",
      "Bash(docker info*)",
      "Bash(docker system df*)",
      "Bash(docker images*)",
      "Bash(docker image ls*)",
      "Bash(docker volume ls*)",
      "Bash(docker volume inspect *)",
      "Bash(docker network ls*)",
      "Bash(docker rm *)",
      "Bash(docker container rm *)",
      "Bash(docker rmi *)",
      "Bash(docker image rm *)",
      "Bash(docker volume rm *)",
      "Bash(docker network rm *)",
      "Bash(docker volume create *)",
      "Bash(docker network create *)",
      "Bash(docker pull *)",
      "Bash(docker manifest inspect *)",
      "Bash(docker compose *)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(chmod +x *)",
      "Bash(rm .local/*)",
      "Bash(rm -f .local/*)",
      "Bash(rm -r .local/*)",
      "Bash(rm -rf .local/*)",

      "Edit(/**)",

      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:pre-commit.com)",
      "WebFetch(domain:just.systems)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(docker push*)",
      "Bash(docker * push*)",
      "Bash(docker login*)",
      "Bash(docker logout*)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",

      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset --keep*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git restore*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git tag -f*)",
      "Bash(git tag --force*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git gc*)",
      "Bash(git update-ref*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove*)",

      "Bash(* prune*)",

      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(**/SPECIFICATIONS.md)",
      "Edit(/.claude/refs/**)",

      "Read(**/.env)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/*.env)"
    ],
    "deny": [
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(aptitude *)",
      "Bash(dpkg *)",
      "Bash(snap *)",
      "Bash(yum *)",
      "Bash(dnf *)",
      "Bash(pacman *)",
      "Bash(zypper *)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
